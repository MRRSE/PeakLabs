<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <section class="section" style="padding-top: 0;">
        <div class="container contact-grid">
            <div class="reveal">
                <form id="contactForm">
                    <div class="form-row">
                        <div class="form-group">
                            <label for="cName">نام</label>
                            <input type="text" id="cName" required autocomplete="name">
                        </div>
                        <div class="form-group">
                            <label for="cEmail">ایمیل</label>
                            <input type="email" id="cEmail" required autocomplete="email">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="cSubject">موضوع</label>
                        <input type="text" id="cSubject" required>
                    </div>
                    <div class="form-group">
                        <label for="cMessage">پیام</label>
                        <textarea id="cMessage" rows="6" required style="resize: vertical;"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">ارسال پیام</button>
                    <div class="form-status" id="contactStatus"></div>
                </form>
            </div>

            <div class="reveal">
                <div class="info-card">
                    <div class="info-row">
                        <i class="bi bi-geo-alt"></i>
                        <div>
                            <strong>دفتر</strong>
                            <span>بندرعباس، خیابان دانشگاه, ساختمان اداری کروش</span>
                        </div>
                    </div>
                    <div class="info-row">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <strong>ایمیل</strong>
                            <span>PeakLabsCompany@gmail.com</span>
                        </div>
                    </div>
                    <div class="info-row">
                        <i class="bi bi-telephone"></i>
                        <div>
                            <strong>شماره تماس</strong>
                            <span dir="ltr">+98 21 0000 0000</span>
                        </div>
                    </div>
                </div>
                <div class="footer-social" style="margin-bottom: 18px;">
                    <a href="#" class="icon-btn" aria-label="GitHub">
                        <i class="bi bi-github"></i>
                    </a>
                    <a href="#" class="icon-btn" aria-label="LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>
</body>
</html>