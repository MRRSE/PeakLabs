@model IReadOnlyList<PeakLabs.Models.Article>

<section class="section" style="padding-top:0;">
    <div class="container">
        <div class="section-title-row reveal">
            <div>
                <span class="eyebrow">تازه‌های تیم</span>
                <h2 style="margin-top:14px;">آخرین مقالات</h2>
            </div>
            <a asp-controller="Article" asp-action="Index" class="btn btn-outline btn-sm">مشاهده همه مقالات</a>
        </div>
        <div class="article-grid">
            @foreach (var article in Model)
            {
                <partial name="~/Views/Article/_ArticleCard.cshtml" model="article" />
            }
        </div>
        @if (Model.Count == 0)
        {
            <p class="muted">هنوز مقاله‌ای منتشر نشده است.</p>
        }
    </div>
</section>
