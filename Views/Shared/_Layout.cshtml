@using Microsoft.EntityFrameworkCore
@using PeakLabs.Data
@using PeakLabs.Models
@inject ApplicationDbContext DbContext
<!DOCTYPE html>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsCurrentPage(string controller, string action = "Index") =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);

    var siteSettings = await DbContext.SiteSettings.AsNoTracking().FirstOrDefaultAsync(settings => settings.Id == 1) ?? new SiteSettings();
    var brandTitle = string.IsNullOrWhiteSpace(siteSettings.SeoTitle) ? siteSettings.SiteTitle : siteSettings.SeoTitle;
    var pageTitle = ViewData["Title"] as string;
    var isHomePage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
    var documentTitle = isHomePage || string.IsNullOrWhiteSpace(pageTitle) ? brandTitle : $"{pageTitle} | {brandTitle}";
    var metaDescription = ViewData["MetaDescription"] as string;
    if (string.IsNullOrWhiteSpace(metaDescription))
        metaDescription = string.IsNullOrWhiteSpace(siteSettings.SeoDescription) ? siteSettings.SiteDescription : siteSettings.SeoDescription;
    Uri? siteBaseUri = null;
    if (!Uri.TryCreate(siteSettings.SiteUrl, UriKind.Absolute, out siteBaseUri)
        || (siteBaseUri.Scheme != Uri.UriSchemeHttp && siteBaseUri.Scheme != Uri.UriSchemeHttps))
        siteBaseUri = new Uri($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}/");
    var canonicalUrl = new Uri(siteBaseUri, Context.Request.Path.Value?.TrimStart('/') ?? string.Empty).AbsoluteUri;
    string? shareImageUrl = null;
    if (Uri.TryCreate(siteSettings.OgImage, UriKind.Absolute, out var absoluteShareImage)
        && (absoluteShareImage.Scheme == Uri.UriSchemeHttp || absoluteShareImage.Scheme == Uri.UriSchemeHttps))
        shareImageUrl = absoluteShareImage.AbsoluteUri;
    else if (!string.IsNullOrWhiteSpace(siteSettings.OgImage) && siteSettings.OgImage.StartsWith('/'))
        shareImageUrl = new Uri(siteBaseUri, siteSettings.OgImage).AbsoluteUri;
}
<html lang="fa" dir="rtl" data-theme="@siteSettings.DefaultTheme" data-default-theme="@siteSettings.DefaultTheme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@documentTitle</title>
<meta name="description" content="@metaDescription" />
<link rel="canonical" href="@canonicalUrl" />
<link rel="icon" href="@Url.Content("~/favicon.ico")" type="image/x-icon" />
<meta property="og:site_name" content="@siteSettings.SiteTitle" />
<meta property="og:title" content="@documentTitle" />
<meta property="og:description" content="@metaDescription" />
<meta property="og:type" content="website" />
<meta property="og:url" content="@canonicalUrl" />
@if (!string.IsNullOrWhiteSpace(shareImageUrl))
{
    <meta property="og:image" content="@shareImageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="@shareImageUrl" />
}
else
{
    <meta name="twitter:card" content="summary" />
}
<meta name="twitter:title" content="@documentTitle" />
<meta name="twitter:description" content="@metaDescription" />
    <script type="importmap"></script>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@

    <link rel="stylesheet" href="~/css/base/variables.css" />
    <link rel="stylesheet" href="~/css/base/reset.css" />
    <link rel="stylesheet" href="~/css/base/typography.css" />
    <link rel="stylesheet" href="~/css/base/utilities.css" />

    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@

    <link rel="stylesheet" href="~/css/components/button.css">
    <link rel="stylesheet" href="~/css/components/card.css">
    <link rel="stylesheet" href="~/css/components/form.css">
    <link rel="stylesheet" href="~/css/components/modal.css">
    <link rel="stylesheet" href="~/css/components/navbar.css">
    <link rel="stylesheet" href="~/css/components/pages.css">
    <link rel="stylesheet" href="~/css/pages/articles.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/pages/about.css">


    <link rel="stylesheet" href="~/fonts/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/PeakLabs.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header class="navbar">
        <div class="container nav-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <svg class="brand-mark" viewBox="0 0 40 40" fill="none">
                    <path d="M4 30 L15 12 L21 21 L26 13 L36 30Z" fill="#10B981" />
                    <path d="M15 12 L21 21 L18 26 L11 26Z" fill="#059669" />
                </svg>
                <span class="brand-name">Peak
                    <span>Labs</span>
                </span>
            </a>
            <nav class="nav-links">
                <a class="@(IsCurrentPage("Home") ? "active" : "")" asp-action="index" asp-controller="home">خانه</a>
                <a class="@(IsCurrentPage("Article") ? "active" : "")" asp-action="index" asp-controller="article">مقالات</a>
                <a class="@(IsCurrentPage("Portfolio") ? "active" : "")" asp-action="index" asp-controller="portfolio">نمونه کارها</a>
                <a class="@(IsCurrentPage("AboutUs") ? "active" : "")" asp-action="index" asp-controller="aboutus">درباره ما</a>
                <a class="@(IsCurrentPage("ContactUs") ? "active" : "")" asp-action="index" asp-controller="contactus">تماس با ما</a>
            </nav>
            <div class="nav-actions">
                <button id="themeToggle" class="icon-btn">
                    <i id="themeIcon" class="bi bi-sun"></i>
                </button>
                <button class="hamburger" id="hamburgerBtn" type="button" aria-label="Open menu" aria-expanded="false">
                    <span></span><span></span><span></span>
                </button>
            </div>
            <nav class="mobile-panel" id="mobilePanel" aria-label="Mobile">
                <a class="@(IsCurrentPage("Home") ? "active" : "")" asp-action="index" asp-controller="home">خانه</a>
                <a class="@(IsCurrentPage("Article") ? "active" : "")" asp-action="index" asp-controller="article">مقالات</a>
                <a class="@(IsCurrentPage("Portfolio") ? "active" : "")" asp-action="index" asp-controller="portfolio">نمونه کارها</a>
                <a class="@(IsCurrentPage("AboutUs") ? "active" : "")" asp-action="index" asp-controller="aboutus">درباره ما</a>
                <a class="@(IsCurrentPage("ContactUs") ? "active" : "")" asp-action="index" asp-controller="contactus">تماس با ما</a>
            </nav>
        </div>
    </header>
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <div class="brand">
                        <svg class="brand-mark" viewBox="0 0 40 40" fill="none">
                            <path d="M4 30 L15 12 L21 21 L26 13 L36 30Z" fill="#10B981" />
                            <path d="M15 12 L21 21 L18 26 L11 26Z" fill="#059669" />
                        </svg>
                        <span class="brand-name">Pick <Span>Labs</Span></span>
                    </div>
                    <p>استودیوی مهندسی نرم‌افزار که درباره معماری، ابر و هنر ساخت سیستم‌های پایدار می‌نویسد.</p>
                    @if (!string.IsNullOrWhiteSpace(siteSettings.Github) || !string.IsNullOrWhiteSpace(siteSettings.Linkedin) || !string.IsNullOrWhiteSpace(siteSettings.Instagram))
                    {
                        <div class="footer-social">
                            @if (!string.IsNullOrWhiteSpace(siteSettings.Github)) { <a class="icon-btn" href="@siteSettings.Github" target="_blank" rel="noopener noreferrer" aria-label="GitHub"><i class="bi bi-github"></i></a> }
                            @if (!string.IsNullOrWhiteSpace(siteSettings.Linkedin)) { <a class="icon-btn" href="@siteSettings.Linkedin" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a> }
                            @if (!string.IsNullOrWhiteSpace(siteSettings.Instagram)) { <a class="icon-btn" href="@siteSettings.Instagram" target="_blank" rel="noopener noreferrer" aria-label="Instagram"><i class="bi bi-instagram"></i></a> }
                        </div>
                    }
                </div>
                <div class="footer-col">
                    <h4>شرکت</h4>
                    <a asp-controller="AboutUs" asp-action="Index">درباره ما</a>
                    <a asp-controller="Article" asp-action="Index">مقالات</a>
                    <a asp-controller="ContactUs" asp-action="Index">تماس با ما</a>
                </div>
                <div class="footer-col">
                    <h4>شبکه های اجتمایی</h4>
                    @if (!string.IsNullOrWhiteSpace(siteSettings.Github)) { <a href="@siteSettings.Github" target="_blank" rel="noopener noreferrer">GitHub</a> }
                    @if (!string.IsNullOrWhiteSpace(siteSettings.Linkedin)) { <a href="@siteSettings.Linkedin" target="_blank" rel="noopener noreferrer">LinkedIn</a> }
                    @if (!string.IsNullOrWhiteSpace(siteSettings.Instagram)) { <a href="@siteSettings.Instagram" target="_blank" rel="noopener noreferrer">Instagram</a> }
                </div>
            </div>
            <div class="footer-bottom">
                <span>© ۲۰۲۶ پیک‌لبز. تمامی حقوق محفوظ است.</span>
                <span>ساخته‌شده با معماری تمیز، درون‌سازمانی.</span>
            </div>
        </div>
        <partial name="_Toast" />
    </footer>
    <link rel="stylesheet" href="~/css/components/responsive.css">
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/components/navbar.js"></script>
    <script src="~/js/base/theme.js" asp-append-version="true"></script>
    <script src="~/js/base/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
