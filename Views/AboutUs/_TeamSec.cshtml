@model IReadOnlyList<PeakLabs.Models.Developer>
<section class="section" style="padding-top:0;">
    <div class="container">
        <div class="section-head reveal"><span class="eyebrow">افراد</span><h2>با تیم آشنا شوید</h2></div>
        @if (Model.Count > 0)
        {
            <div class="team-grid">
                @foreach (var developer in Model)
                {
                    var initials = string.Concat(developer.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0]));
                    <article class="team-card reveal">
                        <div class="team-photo">@initials</div>
                        <h4>@developer.Name</h4>
                        <span class="team-role">@developer.JobTitle</span>
                        @if (!string.IsNullOrWhiteSpace(developer.Bio)) { <p class="team-bio">@developer.Bio</p> }
                        @if (!string.IsNullOrWhiteSpace(developer.LinkedInUrl) || !string.IsNullOrWhiteSpace(developer.GitHubUrl))
                        {
                            <div class="team-socials">
                                @if (!string.IsNullOrWhiteSpace(developer.LinkedInUrl)) { <a href="@developer.LinkedInUrl" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn @developer.Name"><i class="bi bi-linkedin"></i></a> }
                                @if (!string.IsNullOrWhiteSpace(developer.GitHubUrl)) { <a href="@developer.GitHubUrl" target="_blank" rel="noopener noreferrer" aria-label="GitHub @developer.Name"><i class="bi bi-github"></i></a> }
                            </div>
                        }
                    </article>
                }
            </div>
        }
        else
        {
            <p class="team-empty-state">هنوز عضوی برای نمایش ثبت نشده است.</p>
        }
    </div>
</section>
