@model PeakLabs.Models.ContactMessage

<section class="section" style="padding-top: 0;">
        <div class="container contact-grid">
            <div class="reveal">
                <form id="contactForm" asp-controller="ContactUs" asp-action="Index" method="post">
                    @Html.AntiForgeryToken()
                    @if (TempData["ContactSuccess"] is string successMessage)
                    {
                        <div class="form-status" role="status">@successMessage</div>
                    }
                    <div asp-validation-summary="All" class="form-status" role="alert"></div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="cName">نام</label>
                            <input asp-for="Name" type="text" id="cName" maxlength="120" required autocomplete="name">
                        </div>
                        <div class="form-group">
                            <label for="cEmail">ایمیل</label>
                            <input asp-for="Email" type="email" id="cEmail" maxlength="254" required autocomplete="email">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="cSubject">موضوع</label>
                        <input asp-for="Subject" type="text" id="cSubject" maxlength="160" required>
                    </div>
                    <div class="form-group">
                        <label for="cMessage">پیام</label>
                        <textarea asp-for="Message" id="cMessage" maxlength="5000" rows="6" required style="resize: vertical;"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">ارسال پیام</button>
                </form>
            </div>

            <div class="reveal">
                <div class="info-card">
                    <div class="info-row">
                        <i class="bi bi-geo-alt"></i>
                        <div>
                            <strong>دفتر</strong>
                            <span>بندرعباس، خیابان دانشگاه, ساختمان اداری کروش</span>
                        </div>
                    </div>
                    <div class="info-row">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <strong>ایمیل</strong>
                            <span>PeakLabsCompany@gmail.com</span>
                        </div>
                    </div>
                    <div class="info-row">
                        <i class="bi bi-telephone"></i>
                        <div>
                            <strong>شماره تماس</strong>
                            <span dir="ltr">+98 21 0000 0000</span>
                        </div>
                    </div>
                </div>
                <div class="footer-social" style="margin-bottom: 18px;">
                    <a href="#" class="icon-btn" aria-label="GitHub">
                        <i class="bi bi-github"></i>
                    </a>
                    <a href="#" class="icon-btn" aria-label="LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>
