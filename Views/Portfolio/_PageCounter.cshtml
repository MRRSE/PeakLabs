@model PortfolioIndexViewModel

@if (Model.TotalPages > 1)
{
    <nav class="pagination" aria-label="صفحه‌بندی نمونه‌کارها">
        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
        {
            <a class="page-btn @(pageNumber == Model.CurrentPage ? "active" : "")"
               aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)"
               asp-controller="Portfolio" asp-action="Index" asp-route-page="@pageNumber">@pageNumber</a>
        }
    </nav>
}
