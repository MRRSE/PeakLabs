@model IReadOnlyList<PeakLabs.Models.PortfolioItem>

<section class="section portfolio-list-section">
    <div class="container">
        <div class="article-grid">
            @foreach (var item in Model)
            {
                <partial name="~/Views/Portfolio/_PortfolioCard.cshtml" model="item" />
            }
        </div>
        @if (Model.Count == 0)
        {
            <p class="muted">هنوز نمونه‌کاری ثبت نشده است.</p>
        }
    </div>
</section>
