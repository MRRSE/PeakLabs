@{
    Layout = "_AdminLayout";
}


<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
‌     <link rel="stylesheet" href="~/css/Admin/card.css" />
    <title>Document</title>
</head>
<body>
<section class="page active">
    <div class="page-head"><div>
        <span class="eyebrow"><i class="bi bi-kanban"></i><span >نمونه‌کارها</span></span>
            <h1 >مدیریت نمونه‌کار</h1>
            <p class="muted" >کارت‌های پروژه‌ای که در سایت اصلی PeakLabs نمایش داده می‌شوند را مدیریت کنید.</p>
            </div>
            <button class="btn btn-primary"><i class="bi bi-plus-lg"></i><span>پروژه جدید</span></button>
            </div>
            <div class="toolbar">
                </div>
                <div class="card-grid">
                <article class="manage-card">
                <div class="manage-cover cloud">
                <i class="bi bi-box-arrow-up-right" style="position:relative;z-index:2;color:#fff;font-size:1.2rem"></i>
                <span>فین‌تک · ابر</span>
                </div>
                <div class="manage-body">
                <h3>نیمباس‌پی</h3>
                <p>پلتفرم پرداخت چندمنطقه‌ای با تراکنش بلادرنگ و گزارش کامل رویدادها.</p>
                <div class="tags">
                <span class="tag">ASP.NET Core</span>
                <span class="tag">Azure</span>
                <span class="tag">PostgreSQL</span>
                </div>
                <div class="manage-foot">
                <span class="views">
                <i class="bi bi-eye"></i> 4,820 views</span>
                <div class="actions">
                <button class="action"><i class="bi bi-pencil"></i></button>
                <button class="action"><i class="bi bi-trash3"></i></button>
                </div>
                </div>
                </div>
                </article>
                <article class="manage-card">
                <div class="manage-cover ai"><i class="bi bi-box-arrow-up-right" style="position:relative;z-index:2;color:#fff;font-size:1.2rem"></i><span>هوش مصنوعی · جستجو</span>
                </div>
                <div class="manage-body">
                <h3>تریل‌هد</h3>
                <p>موتور جستجوی مستندات مبتنی بر هوش مصنوعی و درک منظور کاربر.</p>
                <div class="tags">
                <span class="tag">Python</span>
                <span class="tag">Vector DB</span>
                <span class="tag">LLM</span>
                </div>
                <div class="manage-foot">
                <span class="views"><i class="bi bi-eye"></i> 3,240 views</span>
                <div class="actions">
                <button class="action" ><i class="bi bi-pencil"></i></button>
                <button class="action"><i class="bi bi-trash3"></i></button>
                </div>
                </div>
                </div>
                </article>
                <article class="manage-card">
                <div class="manage-cover orange">
                <i class="bi bi-box-arrow-up-right" style="position:relative;z-index:2;color:#fff;font-size:1.2rem"></i>
                <span>لجستیک · DevOps</span>
                </div>
                <div class="manage-body">
                <h3>فلیتلی</h3>
                <p>سامانه مدیریت ناوگان با رهگیری زنده و دسترس‌پذیری بالا.</p>
                <div class="tags">
                <span class="tag">.NET</span>
                <span class="tag">Docker</span>
                <span class="tag">K8s</span>
                </div>
                <div class="manage-foot">
                <span class="views"><i class="bi bi-eye"></i> 2,780 views</span>
                <div class="actions">
                <button class="action"><i class="bi bi-pencil"></i></button>
                <button class="action"><i class="bi bi-trash3"></i></button>
                </div>
                </div>
                </div>
            </article>
        </div>
</section>
</body>
</html>