@model PeakLabs.Models.PortfolioIndexViewModel

@if (Model.TotalPages > 1)
{
    <nav class="pagination" aria-label="صفحه‌بندی نمونه‌کارها">
        @if (Model.CurrentPage > 1)
        {
            <a class="page-btn" asp-controller="Portfolio" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" aria-label="صفحه قبل"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
        }
        @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
        {
            <a class="page-btn @(pageNumber == Model.CurrentPage ? "active" : "")" asp-controller="Portfolio" asp-action="Index" asp-route-page="@pageNumber" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">@pageNumber</a>
        }
        @if (Model.CurrentPage < Model.TotalPages)
        {
            <a class="page-btn" asp-controller="Portfolio" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" aria-label="صفحه بعد"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
        }
    </nav>
}
