@using Microsoft.EntityFrameworkCore
@using PeakLabs.Data
@inject ApplicationDbContext DbContext
@model PeakLabs.Models.ContactMessage
@{
    var contactSettings = await DbContext.SiteSettings.AsNoTracking().FirstOrDefaultAsync(settings => settings.Id == 1);
}

<section class="section" style="padding-top: 0;">
        <div class="container contact-grid">
            <div class="reveal">
                <form id="contactForm" asp-controller="ContactUs" asp-action="Index" method="post">
                    @Html.AntiForgeryToken()
                    @if (TempData["ContactSuccess"] is string successMessage)
                    {
                        <div class="contact-success-message" role="status"><i class="bi bi-check-circle-fill" aria-hidden="true"></i><span>@successMessage</span></div>
                    }
                    <div asp-validation-summary="All" class="form-status" role="alert"></div>
                    <div class="form-row">
                        <div class="form-group">
                            <label for="cName">نام</label>
                            <input asp-for="Name" type="text" id="cName" maxlength="120" required autocomplete="name">
                        </div>
                        <div class="form-group">
                            <label for="cEmail">ایمیل</label>
                            <input asp-for="Email" type="email" id="cEmail" maxlength="254" required autocomplete="email">
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="cSubject">موضوع</label>
                        <input asp-for="Subject" type="text" id="cSubject" maxlength="160" required>
                    </div>
                    <div class="form-group">
                        <label for="cMessage">پیام</label>
                        <textarea asp-for="Message" id="cMessage" maxlength="5000" rows="6" required style="resize: vertical;"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-block">ارسال پیام</button>
                </form>
            </div>

            <div class="reveal">
                @if (contactSettings is not null && (!string.IsNullOrWhiteSpace(contactSettings.Address)
                    || !string.IsNullOrWhiteSpace(contactSettings.ContactEmail)
                    || !string.IsNullOrWhiteSpace(contactSettings.ContactPhone)))
                {
                    <div class="info-card">
                        @if (!string.IsNullOrWhiteSpace(contactSettings.Address))
                        {
                            <div class="info-row"><i class="bi bi-geo-alt"></i><div><strong>دفتر</strong><span>@contactSettings.Address</span></div></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(contactSettings.ContactEmail))
                        {
                            <div class="info-row"><i class="bi bi-envelope"></i><div><strong>ایمیل</strong><a href="mailto:@contactSettings.ContactEmail">@contactSettings.ContactEmail</a></div></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(contactSettings.ContactPhone))
                        {
                            <div class="info-row"><i class="bi bi-telephone"></i><div><strong>شماره تماس</strong><a href="tel:@contactSettings.ContactPhone" dir="ltr">@contactSettings.ContactPhone</a></div></div>
                        }
                    </div>
                }
                @if (contactSettings is not null && (!string.IsNullOrWhiteSpace(contactSettings.Github)
                    || !string.IsNullOrWhiteSpace(contactSettings.Linkedin)
                    || !string.IsNullOrWhiteSpace(contactSettings.Instagram)))
                {
                    <div class="footer-social" style="margin-bottom: 18px;">
                        @if (!string.IsNullOrWhiteSpace(contactSettings.Github)) { <a href="@contactSettings.Github" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="GitHub"><i class="bi bi-github"></i></a> }
                        @if (!string.IsNullOrWhiteSpace(contactSettings.Linkedin)) { <a href="@contactSettings.Linkedin" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a> }
                        @if (!string.IsNullOrWhiteSpace(contactSettings.Instagram)) { <a href="@contactSettings.Instagram" target="_blank" rel="noopener noreferrer" class="icon-btn" aria-label="Instagram"><i class="bi bi-instagram"></i></a> }
                    </div>
                }
            </div>
        </div>
    </section>
