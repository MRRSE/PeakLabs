@model PeakLabs.Areas.Admin.Models.ContactMessagesIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "پیام‌های تماس";
}

<form id="contactMessagesToken" hidden>@Html.AntiForgeryToken()</form>
<section class="page active" id="contactMessagesPage"
         data-update-url="@Url.Action("SetAnswered", "ContactMessages", new { area = "Admin" })">
    <div class="page-head">
        <div>
            <span class="eyebrow"><i class="bi bi-envelope"></i><span>تماس با ما</span></span>
            <h1>پیام‌های دریافت‌شده</h1>
            <p class="muted">پیام‌ها را بررسی کنید و بعد از پاسخ‌گویی به بخش پاسخ‌داده‌شده‌ها منتقل کنید.</p>
        </div>
    </div>
    <nav class="contact-message-tabs" aria-label="دسته‌بندی پیام‌ها">
        <a class="@(Model.Answered ? "" : "active")" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index" asp-route-answered="false">
            در انتظار <span>@Model.PendingCount</span>
        </a>
        <a class="@(Model.Answered ? "active" : "")" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index" asp-route-answered="true">
            پاسخ‌داده‌شده <span>@Model.AnsweredCount</span>
        </a>
    </nav>
    <div class="panel">
        <div class="table-wrap">
            <table class="table contact-message-table">
                <thead><tr><th>فرستنده</th><th>موضوع</th><th>متن پیام</th><th>تاریخ ارسال</th><th>وضعیت</th></tr></thead>
                <tbody>
                @if (Model.Messages.Count == 0)
                {
                    <tr><td colspan="5" class="muted">@(Model.Answered ? "پیام پاسخ‌داده‌شده‌ای ثبت نشده است." : "پیامی در انتظار بررسی نیست.")</td></tr>
                }
                @foreach (var message in Model.Messages)
                {
                    <tr>
                        <td><div class="item-title">@message.Name</div><a href="mailto:@message.Email">@message.Email</a></td>
                        <td>@message.Subject</td>
                        <td><button type="button" class="contact-message-preview" data-message="@message.Message" data-subject="@message.Subject" data-sender="@message.Name" aria-label="خواندن متن کامل پیام از @message.Name">@message.Message</button></td>
                        <td>@message.SentAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                        <td><label class="contact-message-status"><input type="checkbox" class="contact-message-answered" data-id="@message.Id" checked="@message.IsAnswered" /> <span>@(message.IsAnswered ? "پاسخ داده شد" : "پاسخ داده‌ام")</span></label></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="pagination" aria-label="صفحه‌بندی پیام‌ها">
                @if (Model.CurrentPage > 1)
                {
                    <a class="btn btn-secondary" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index" asp-route-answered="@Model.Answered" asp-route-page="@(Model.CurrentPage - 1)">قبلی</a>
                }
                <span class="muted">صفحه @Model.CurrentPage از @Model.TotalPages</span>
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a class="btn btn-secondary" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index" asp-route-answered="@Model.Answered" asp-route-page="@(Model.CurrentPage + 1)">بعدی</a>
                }
            </nav>
        }
    </div>
</section>

<dialog class="contact-message-dialog" id="contactMessageDialog" aria-labelledby="contactMessageDialogTitle">
    <div class="contact-message-dialog-head">
        <div><h2 id="contactMessageDialogTitle"></h2><p id="contactMessageDialogSender"></p></div>
        <button type="button" class="icon-btn" id="contactMessageDialogClose" aria-label="بستن"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="contact-message-dialog-body" id="contactMessageDialogBody"></div>
</dialog>
@section Scripts {
    <script src="~/js/Admin/contact-messages.js" asp-append-version="true"></script>
}
