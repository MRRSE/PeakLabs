@{
  Layout = "_AdminLayout";
  var welcomeName = ViewData["WelcomeName"] as string ?? "کاربر";
  var topArticles = (IReadOnlyList<PeakLabs.Models.Article>)ViewData["TopArticles"]!;
  var recentActivities = (IReadOnlyList<PeakLabs.Models.DashboardActivity>)ViewData["RecentActivities"]!;
  var numberFormat = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
  var articleViewsTrend = (dynamic)ViewData["ArticleViewsTrend"]!;
  var publishedArticlesTrend = (dynamic)ViewData["PublishedArticlesTrend"]!;
  var portfolioTrend = (dynamic)ViewData["PortfolioTrend"]!;
  var accountsTrend = (dynamic)ViewData["AccountsTrend"]!;
  string TrendText(dynamic trend) => trend.Percentage == 0 ? "بدون تغییر نسبت به ماه قبل" : $"{(trend.Percentage > 0 ? "افزایش" : "کاهش")} {Math.Abs((decimal)trend.Percentage):0.#}% نسبت به ماه قبل";
  string TrendClass(dynamic trend) => trend.Percentage < 0 ? "trend trend-down" : "trend";
}

<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
</head>

<body>
<form id="articleAntiforgeryToken" hidden>
  @Html.AntiForgeryToken()
</form>
<section class="page active">
<div class="page-head">
  <div>
    <span class="eyebrow">
      <i class="bi bi-activity"></i>
      <span>داشبورد</span>
    </span>
    <h1 id="dashboardGreeting" data-first-name="@welcomeName">سلام، @welcomeName.</h1>
    <p class="muted">وضعیت فعلی وب‌سایت PeakLabs را اینجا می‌بینید.</p>
  </div>
</div>

<div class="modal" id="activitiesModal" hidden>
  <div class="modal-backdrop" data-close-activities></div>
  <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="activitiesModalTitle">
    <div class="dialog-head"><h2 id="activitiesModalTitle">همه فعالیت‌ها</h2><button type="button" class="icon-btn" data-close-activities><i class="bi bi-x"></i></button></div>
    <div class="dialog-body" id="allActivitiesList"></div>
    <div class="dialog-foot"><button type="button" class="btn btn-outline btn-sm" id="activitiesMore">فعالیت‌های قدیمی‌تر</button></div>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', () => { const modal=document.getElementById('activitiesModal'), list=document.getElementById('allActivitiesList'), more=document.getElementById('activitiesMore'); let page=0;
async function load(){ page++; const r=await fetch(`/Admin/Dashboard/Activities?page=${page}`); const d=await r.json(); d.items.forEach(x=>{const e=document.createElement('div');e.className='activity-item';e.innerHTML=`<span class="activity-dot"></span><div><strong>${x.message}</strong><time>${new Date(x.occurredAt).toLocaleString('fa-IR')}</time></div>`;list.appendChild(e)}); more.hidden=!d.hasNext; }
document.querySelector('[data-open-activities]')?.addEventListener('click',()=>{modal.hidden=false;modal.classList.add('open');if(!page)load()}); document.querySelectorAll('[data-close-activities]').forEach(x=>x.addEventListener('click',()=>{modal.hidden=true;modal.classList.remove('open')})); more?.addEventListener('click',load); });
</script>
<div class="stats">
  <div class="stat">
    <div class="stat-top">
      <span class="tiny" data-t="totalViews">
        بازدید مقالات
      </span>
      <span class="stat-icon">
        <i class="bi bi-eye"></i>
      </span>
    </div>
    <strong>@(((long)ViewData["ArticleViewTotal"]!).ToString("N0", numberFormat))</strong>
    <span class="@TrendClass(articleViewsTrend)">
      <i class="bi @(articleViewsTrend.Percentage < 0 ? "bi-arrow-down-left" : "bi-arrow-up-right")"></i>
      <span>@TrendText(articleViewsTrend)</span>
    </span>
  </div>
  <div class="stat">
    <div class="stat-top">
      <span class="tiny" data-t="publishedArticles">
        مقالات منتشر شده
      </span>
      <span class="stat-icon">
        <i class="bi bi-journal-richtext">
        </i>
      </span>
    </div>
    <strong>@(((int)ViewData["PublishedArticleCount"]!).ToString("N0", numberFormat))</strong>
    <span class="@TrendClass(publishedArticlesTrend)">
      <i class="bi @(publishedArticlesTrend.Percentage < 0 ? "bi-arrow-down-left" : "bi-arrow-up-right")"></i>
      <span>@TrendText(publishedArticlesTrend)</span>
    </span>
  </div>
  <div class="stat">
    <div class="stat-top">
      <span class="tiny" data-t="portfolioItems">
        نمونه کارها
      </span>
      <span class="stat-icon">
        <i class="bi bi-boxes"></i>
      </span>
    </div>
    <strong>@(((int)ViewData["PortfolioCount"]!).ToString("N0", numberFormat))</strong>
    <a class="trend" asp-area="Admin" asp-controller="Portfolio" asp-action="Index">
      <i class="bi bi-pencil-square" aria-hidden="true"></i><span>مدیریت و ویرایش نمونه‌کارها</span>
    </a>
    <span class="@TrendClass(portfolioTrend)">
      <i class="bi @(portfolioTrend.Percentage < 0 ? "bi-arrow-down-left" : "bi-arrow-up-right")"></i>
      <span>@TrendText(portfolioTrend)</span>
    </span>
  </div>
  <div class="stat">
    <div class="stat-top">
      <span class="tiny" data-t="teamMembers">
        اعضای تیم
      </span>
      <span class="stat-icon">
        <i class="bi bi-people"></i>
      </span>
    </div>
    <strong>@(((int)ViewData["ActiveAccountCount"]!).ToString("N0", numberFormat))</strong>
    <span class="@TrendClass(accountsTrend)">
      <i class="bi @(accountsTrend.Percentage < 0 ? "bi-arrow-down-left" : "bi-arrow-up-right")"></i>
      <span>@TrendText(accountsTrend) · فعال</span>
    </span>
  </div>
</div>
<div class="grid-2">
  <div class="panel">
    <div class="panel-head">
      <div>
        <h2 id="dashboardChartTitle">بازدید مقاله‌ها</h2>
        <span class="tiny">آمار واقعی ثبت‌شده را بر اساس منبع و بازهٔ زمانی ببینید.</span>
      </div>
      <div class="chart-filters">
        <select class="select" id="dashboardChartSource" aria-label="منبع نمودار">
          <option value="articles">بازدید مقاله‌ها</option>
          <option value="traffic">ترافیک سایت</option>
        </select>
        <select class="select" id="articleViewCategory" aria-label="دسته‌بندی نمودار بازدید">
          <option value="all">همهٔ دسته‌بندی‌ها</option>
          @foreach (var category in (IReadOnlyList<string>)ViewData["ArticleViewCategories"]!)
          {
            <option value="@category">@category</option>
          }
        </select>
        <select class="select" id="articleViewPeriod" aria-label="بازهٔ نمودار بازدید">
          <option value="daily">روزانه</option>
          <option value="weekly">هفتگی</option>
          <option value="monthly" selected>ماهانه</option>
          <option value="yearly">سالانه</option>
        </select>
      </div>
    </div>
    <div class="panel-body">
      <div class="chart">
        <canvas id="articleViewsChart"></canvas>
      </div>
      <div class="chart-labels" id="articleViewChartLabels" aria-hidden="true"></div>
    </div>
  </div>
  <div class="panel">
    <div class="panel-head">
      <div>

        <h2 class="acticity">فعالیت‌های اخیر</h2>
        <span class="tiny">رویدادهای زنده محیط کاری</span>
      </div>
      <button class="btn btn-outline btn-sm" type="button" data-open-activities>همه فعالیت‌ها</button>
    </div>
    <div class="panel-body">
      <div class="activity">
        @foreach (var activity in recentActivities)
        {
        <div class="activity-item">
          <span class="activity-dot"></span>
          <div>
            <strong>@activity.Message</strong>
            <time>@activity.OccurredAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</time>
          </div>
        </div>
        }
      </div>
    </div>
  </div>


</div>
<div class="panel" style="margin-top:18px">
  <div class="panel-head">
    <div>
      <h2>مقالات پربازدید</h2>
      <span class="tiny">مقاله‌های منتشرشده بر اساس مجموع بازدید</span>
    </div>
    <button class="btn btn-outline btn-sm" onclick="go('articles')" data-t="manage">مدیریت</button>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead>
      <tr>
        <th data-t="article">مقاله</th><th data-t="author">نویسنده</th><th data-t="views">بازدید</th><th data-t="status">وضعیت</th><th></th>
      </tr>
      </thead>
      <tbody id="topRows">
      @foreach (var article in topArticles)
      {
        var authorName = article.Author is null ? "نویسنده نامشخص" : $"{article.Author.FirstName} {article.Author.LastName}".Trim();
        <tr>
          <td>
            <div style="display:flex;align-items:center;gap:10px">
              <div class="thumb"><i class="bi bi-journal-text"></i></div>
              <div>
                <div class="item-title">@article.Title</div>
                <div class="item-desc">@article.ShortDescription</div>
              </div>
            </div>
          </td>
          <td>@authorName</td>
          <td><strong>@article.ViewCount.ToString("N0", numberFormat)</strong></td>
          <td><span class="status published">منتشرشده</span></td>
          <td><a class="action" asp-area="Admin" asp-controller="Articles" asp-action="Index" aria-label="مدیریت مقاله‌ها"><i class="bi bi-arrow-up-left"></i></a></td>
        </tr>
      }
      @if (topArticles.Count == 0)
      {
        <tr><td colspan="5" class="muted">هنوز مقالهٔ منتشرشده‌ای وجود ندارد.</td></tr>
      }
      </tbody>
    </table>
  </div>
</div>
</section>
<script>
  window.articleCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      ((IReadOnlyList<PeakLabs.Models.ArticleCategory>)ViewData["ArticleCategories"]!).Select(category => new { category.Id, category.Name }),
      new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
  window.articleViewsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      topArticles.Select(article => new { label = article.Title, value = article.ViewCount }),
      new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
  window.articleViewsTrends = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      ViewData["ArticleViewTrends"],
      new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
  window.siteTrafficTrends = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      ViewData["SiteTrafficTrends"],
      new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
</script>
</body>

</html>

@section Scripts {
  <script src="~/js/Admin/articles.js" asp-append-version="true"></script>
}
