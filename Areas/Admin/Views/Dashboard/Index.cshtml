@{
  Layout = "_AdminLayout";
  var welcomeName = ViewData["WelcomeName"] as string ?? "کاربر";
  var topArticles = (IReadOnlyList<PeakLabs.Models.Article>)ViewData["TopArticles"]!;
  var numberFormat = System.Globalization.CultureInfo.GetCultureInfo("fa-IR");
}

<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
</head>

<body>
<form id="articleAntiforgeryToken" hidden>
  @Html.AntiForgeryToken()
</form>
<section class="page active">
<div class="page-head">
  <div>
    <span class="eyebrow">
      <i class="bi bi-activity"></i>
      <span>داشبورد</span>
    </span>
    <h1 id="dashboardGreeting" data-first-name="@welcomeName">سلام، @welcomeName.</h1>
    <p class="muted">وضعیت فعلی وب‌سایت PeakLabs را اینجا می‌بینید.</p>
  </div>
</div>
<div class="stats">
  <div class="stat">
    <div class="stat-top">
      <span class="tiny" data-t="totalViews">
        بازدید مقالات
      </span>
      <span class="stat-icon">
        <i class="bi bi-eye"></i>
      </span>
    </div>
    <strong>@(((long)ViewData["ArticleViewTotal"]!).ToString("N0", numberFormat))</strong>
    <span class="trend">
      <i class="bi bi-eye"></i>
      <span>بازدید ثبت‌شدهٔ مقاله‌های منتشرشده</span>
    </span>
  </div>
  <div class="stat">
    <div class="stat-top">
      <span class="tiny" data-t="publishedArticles">
        مقالات منتشر شده
      </span>
      <span class="stat-icon">
        <i class="bi bi-journal-richtext">
        </i>
      </span>
    </div>
    <strong>@(((int)ViewData["PublishedArticleCount"]!).ToString("N0", numberFormat))</strong>
    <span class="trend">
      <i class="bi bi-journal-check"></i>
      <span>منتشرشده</span>
    </span>
  </div>
  <div class="stat">
    <div class="stat-top">
      <span class="tiny" data-t="portfolioItems">
        نمونه کارها
      </span>
      <span class="stat-icon">
        <i class="bi bi-boxes"></i>
      </span>
    </div>
    <strong>@(((int)ViewData["PortfolioCount"]!).ToString("N0", numberFormat))</strong>
    <a class="trend" asp-area="Admin" asp-controller="Portfolio" asp-action="Index">
      <i class="bi bi-pencil-square" aria-hidden="true"></i><span>مدیریت و ویرایش نمونه‌کارها</span>
    </a>
  </div>
  <div class="stat">
    <div class="stat-top">
      <span class="tiny" data-t="teamMembers">
        اعضای تیم
      </span>
      <span class="stat-icon">
        <i class="bi bi-people"></i>
      </span>
    </div>
    <strong>
      12
    </strong>
    <span class="trend">
      <i class="bi bi-check2"></i> 100%
      <span data-t="active">فعال</span>
    </span>
  </div>
</div>
<div class="grid-2">
  <div class="panel">
    <div class="panel-head">
      <div>
        <h2>بازدید مقاله‌ها</h2>
        <span class="tiny">دسته‌بندی و بازهٔ زمانی را برای بررسی کلیک‌ها انتخاب کنید.</span>
      </div>
      <div class="chart-filters">
        <select class="select" id="articleViewCategory" aria-label="دسته‌بندی نمودار بازدید">
          <option value="all">همهٔ دسته‌بندی‌ها</option>
          @foreach (var category in (IReadOnlyList<string>)ViewData["ArticleViewCategories"]!)
          {
            <option value="@category">@category</option>
          }
        </select>
        <select class="select" id="articleViewPeriod" aria-label="بازهٔ نمودار بازدید">
          <option value="daily">روزانه</option>
          <option value="weekly">هفتگی</option>
          <option value="monthly" selected>ماهانه</option>
          <option value="yearly">سالانه</option>
        </select>
      </div>
    </div>
    <div class="panel-body">
      <div class="chart">
        <canvas id="articleViewsChart"></canvas>
      </div>
      <div class="chart-labels" id="articleViewChartLabels" aria-hidden="true"></div>
    </div>
  </div>
  <div class="panel">
    <div class="panel-head">
      <div>

        <h2 class="acticity">فعالیت‌های اخیر</h2>
        <span class="tiny">رویدادهای زنده محیط کاری</span>
      </div>
      <i class="bi bi-three-dots"></i>
    </div>
    <div class="panel-body">
      <div class="activity">
        <div class="activity-item">
          <span class="activity-dot"></span>
          <div>
            <strong>سارا یک مقاله منتشر کرد</strong>
            <p>Designing clean architecture...</p>
            <time>2 ساعت پیش</time>
          </div>
        </div>
        <div class="activity-item">
          <span class="activity-dot"></span>
          <div>
            <strong>رضا پروژه NimbusPay را به‌روزرسانی کرد</strong>
            <p>Portfolio cover and tech stack</p>
            <time>48 دقیقه پیش</time>
          </div>
        </div>
        <div class="activity-item">
          <span class="activity-dot"></span>
          <div>
            <strong>توسعه‌دهنده جدید دعوت شد</strong>
            <p>alex@peaklabs.dev · Editor</p>
            <time>2 ساعت پیش</time>
          </div>
        </div>
        <div class="activity-item">
          <span class="activity-dot"></span>
          <div>
            <strong>بازدید یک مقاله از ۱۰۰۰ گذشت</strong>
            <p>Prompt design patterns...</p>
            <time>4 ساعت پیش</time>
          </div>
        </div>
      </div>
    </div>
  </div>


</div>
<div class="panel" style="margin-top:18px">
  <div class="panel-head">
    <div>
      <h2>مقالات پربازدید</h2>
      <span class="tiny">مقاله‌های منتشرشده بر اساس مجموع بازدید</span>
    </div>
    <button class="btn btn-outline btn-sm" onclick="go('articles')" data-t="manage">مدیریت</button>
  </div>
  <div class="table-wrap">
    <table class="table">
      <thead>
      <tr>
        <th data-t="article">مقاله</th><th data-t="author">نویسنده</th><th data-t="views">بازدید</th><th data-t="status">وضعیت</th><th></th>
      </tr>
      </thead>
      <tbody id="topRows">
      @foreach (var article in topArticles)
      {
        var authorName = article.Author is null ? "نویسنده نامشخص" : $"{article.Author.FirstName} {article.Author.LastName}".Trim();
        <tr>
          <td>
            <div style="display:flex;align-items:center;gap:10px">
              <div class="thumb"><i class="bi bi-journal-text"></i></div>
              <div>
                <div class="item-title">@article.Title</div>
                <div class="item-desc">@article.ShortDescription</div>
              </div>
            </div>
          </td>
          <td>@authorName</td>
          <td><strong>@article.ViewCount.ToString("N0", numberFormat)</strong></td>
          <td><span class="status published">منتشرشده</span></td>
          <td><a class="action" asp-area="Admin" asp-controller="Articles" asp-action="Index" aria-label="مدیریت مقاله‌ها"><i class="bi bi-arrow-up-left"></i></a></td>
        </tr>
      }
      @if (topArticles.Count == 0)
      {
        <tr><td colspan="5" class="muted">هنوز مقالهٔ منتشرشده‌ای وجود ندارد.</td></tr>
      }
      </tbody>
    </table>
  </div>
</div>
</section>
<script>
  window.articleCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      ((IReadOnlyList<PeakLabs.Models.ArticleCategory>)ViewData["ArticleCategories"]!).Select(category => new { category.Id, category.Name }),
      new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
  window.articleViewsData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      topArticles.Select(article => new { label = article.Title, value = article.ViewCount }),
      new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
  window.articleViewsTrends = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
      ViewData["ArticleViewTrends"],
      new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
</script>
</body>

</html>

@section Scripts {
  <script src="~/js/Admin/articles.js" asp-append-version="true"></script>
}
