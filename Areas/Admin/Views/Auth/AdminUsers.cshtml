@model PeakLabs.Areas.Admin.Models.AdminUsersViewModel
@{
    Layout = "_AdminLayout";
}

<html lang="fa">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/admin/developers.css">
    <title>Document</title>
</head>

<body>
    <section class="page active">
        <div id="accountAntiforgeryToken"
             data-create-url="@Url.Action("CreateAccount", "Auth", new { area = "Admin" })"
             data-delete-url="@Url.Action("DeleteAccount", "Auth", new { area = "Admin" })" hidden>
            @Html.AntiForgeryToken()
        </div>
        <div class="page-head">
            <div>
                <span class="eyebrow">
                    <i class="bi bi-person-lock"></i>
                    <span>حساب های داشبورد</span>
                </span>

                <h1>مدیریت حساب‌های داشبورد</h1>
                <p class="muted">
                    حساب افرادی را که اجازه ورود به پنل مدیریت دارند ایجاد و
                    مدیریت کنید.
                </p>
            </div>
            <button class="btn btn-primary" onclick="openModal('account')">
                <i class="bi bi-person-plus"></i>ایجاد حساب کاربری
            </button>
        </div>
        <div class="account-summary">
            <div class="stat">
                <span class="tiny">تعداد حساب‌ها</span><strong id="accountCount">@Model.TotalCount</strong>
            </div>
            <div class="stat">
                <span class="tiny">حساب‌های فعال</span><strong id="activeAccountCount">@Model.ActiveCount</strong>
            </div>
            <div class="stat">
                <span class="tiny">حساب‌های غیرفعال</span><strong id="inactiveAccountCount">@Model.InactiveCount</strong>
            </div>
        </div>
        <div class="panel">
            <div class="panel-head">
                <div>
                    <h2>حساب‌های داشبورد</h2>
                    <span class="tiny">نقش انتخاب‌شده برای هر حساب در این فهرست نمایش داده می‌شود.</span>
                </div>
            </div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>کاربر</th>
                            <th>نقش</th>
                            <th>دسترسی‌ها</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Accounts.Count == 0)
                        {
                            <tr><td colspan="5" class="muted">هنوز حسابی ساخته نشده است.</td></tr>
                        }
                        else
                        {
                            @foreach (var account in Model.Accounts)
                            {
                                <tr>
                                    <td>
                                        <div class="member">
                                            @if (!string.IsNullOrWhiteSpace(account.ProfileImagePath))
                                            {
                                                <img class="avatar account-avatar" src="@account.ProfileImagePath" alt="تصویر @account.FirstName @account.LastName">
                                            }
                                            else
                                            {
                                                <div class="avatar account-avatar">@account.Initials</div>
                                            }
                                            <div>
                                                <div class="item-title">@account.FirstName @account.LastName</div>
                                                <div class="role">@account.UserName · @account.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>@account.RoleDisplayName</td>
                                    <td><span class="permission">@account.AccessDescription</span></td>
                                    <td>
                                        <span class="status @(account.IsActive ? "published" : "draft")">
                                            @(account.IsActive ? "فعال" : "غیرفعال")
                                        </span>
                                    </td>
                                    <td>
                                        <button class="icon-btn account-delete-button"
                                                type="button"
                                                data-account-id="@account.Id"
                                                data-account-name="@account.FirstName @account.LastName"
                                                aria-label="حذف حساب @account.FirstName @account.LastName"
                                                title="حذف حساب">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</body>

</html>
