@model IReadOnlyList<PeakLabs.Models.PortfolioItem>
    <div class="page-header reveal">
        <div class="peak-pattern" aria-hidden="true"></div>
        <div class="container" style="position:relative;">
            <span class="eyebrow">
                <i class="bi bi-triangle-fill" style="font-size:.7rem;"></i>
                <span>نمونه کارها</span>
            </span>
            <h1>همه نمونه‌کارها</h1>
            <p>هر محصول و پلتفرمی که از صفر تا استقرار طراحی و پیاده‌سازی کرده‌ایم — برای ابزارهای خودمان و برای مشتریان.</p>
            <div class="page-header-stats">
                <div><strong id="statTotal">@Model.Count</strong><span>پروژه تحویل‌شده</span></div>
                <div><strong>2021</strong><span data-i18n="pf.stat3">سال شروع فعالیت</span></div>
            </div>
        </div>
    </div>
