@model IReadOnlyList<PeakLabs.Models.ArticleCategorySummary>
@using System.Globalization

@{
    var icons = new[]
    {
        "bi-cpu", "bi-diagram-3", "bi-stars", "bi-cloud",
        "bi-gear-wide-connected", "bi-code-slash", "bi-person-badge", "bi-diagram-2"
    };
    var numberFormat = CultureInfo.GetCultureInfo("fa-IR");
}

<section class="section" style="padding-top: 20px;">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow">موضوعات</span>
            <h2>کاوش بر اساس دسته‌بندی</h2>
            <p>بررسی عمیق در سراسر پشته فناوری، از تصمیمات معماری تا استقرار در محیط عملیاتی.</p>
        </div>
        <div class="category-grid">
            @for (var index = 0; index < Model.Count; index++)
            {
                var category = Model[index];
                <a asp-controller="Article" asp-action="Index" asp-route-categoryId="@category.Id" class="category-card">
                    <i class="bi @icons[index % icons.Length]"></i>
                    <span>@category.Name</span>
                    <small>@category.ArticleCount.ToString("N0", numberFormat) مقاله</small>
                </a>
            }
        </div>
    </div>
</section>
