@model PeakLabs.Models.HomeIndexViewModel

<section class="section" id="categories" style="padding-top: 20px;">
    <div class="container">
        <div class="section-head reveal">
            <span class="eyebrow">موضوعات</span>
            <h2>کاوش بر اساس دسته‌بندی</h2>
            <p>بررسی عمیق در سراسر پشته فناوری، از تصمیمات معماری تا استقرار در محیط عملیاتی.</p>
        </div>
        <div class="category-grid">
            @foreach (var category in Model.Categories)
            {
                <a href="/Article?categoryId=@category.Id" class="category-card">
                    <i class="bi bi-hash" aria-hidden="true"></i>
                    <span>@category.Name</span>
                    <small>@category.ArticleCount مقاله</small>
                </a>
            }
        </div>
        @if (Model.CategoryPageCount > 1)
        {
            <nav class="pagination" aria-label="صفحه‌بندی دسته‌بندی‌ها">
                @for (var pageNumber = 1; pageNumber <= Model.CategoryPageCount; pageNumber++)
                {
                    <a class="page-btn @(pageNumber == Model.CategoryPage ? "active" : "")"
                       asp-controller="Home" asp-action="Index" asp-route-categoryPage="@pageNumber" asp-fragment="categories"
                       aria-label="صفحه @pageNumber" aria-current="@(pageNumber == Model.CategoryPage ? "page" : null)">@pageNumber</a>
                }
            </nav>
        }
    </div>
</section>
