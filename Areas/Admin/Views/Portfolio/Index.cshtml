@model IReadOnlyList<PeakLabs.Models.PortfolioItem>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "مدیریت نمونه‌کار";
}

<form id="portfolioAntiforgeryToken" hidden>
    @Html.AntiForgeryToken()
</form>

<section class="page active">
    <div class="page-head">
        <div>
            <span class="eyebrow"><i class="bi bi-kanban"></i><span>نمونه‌کارها</span></span>
            <h1>مدیریت نمونه‌کار</h1>
            <p class="muted">کارت‌های پروژه‌ای که در سایت اصلی PeakLabs نمایش داده می‌شوند را مدیریت کنید.</p>
        </div>
        <button class="btn btn-primary" type="button" onclick="openModal('portfolio')">
            <i class="bi bi-plus-lg"></i><span>پروژه جدید</span>
        </button>
    </div>

    <div class="card-grid">
        @if (Model.Count == 0)
        {
            <p class="muted">هنوز نمونه‌کاری ثبت نشده است.</p>
        }
        @foreach (var item in Model)
        {
            <article class="manage-card">
                <div class="manage-cover">
                    <img class="manage-cover-image" src="@item.ProjectImagePath" alt="تصویر @item.ProjectName" />
                    <a class="manage-cover-project-link" href="@item.ProjectLink" target="_blank" rel="noopener noreferrer" aria-label="مشاهده @item.ProjectName">
                        <i class="bi bi-box-arrow-up-right"></i>
                    </a>
                </div>
                <div class="manage-body">
                    <h3>@item.ProjectName</h3>
                    <p>@item.ProjectDescription</p>
                    <div class="manage-foot">
                        <span class="muted">@item.AddedAt.ToLocalTime().ToString("yyyy/MM/dd")</span>
                        <div class="actions">
                            <button class="action portfolio-edit-button" type="button"
                                    data-portfolio-id="@item.Id" data-portfolio-name="@item.ProjectName"
                                    data-portfolio-description="@item.ProjectDescription" data-portfolio-link="@item.ProjectLink"
                                    data-portfolio-image="@item.ProjectImagePath"
                                    title="ویرایش نمونه‌کار" aria-label="ویرایش نمونه‌کار @item.ProjectName">
                                <i class="bi bi-pencil-square"></i>
                            </button>
                            <a class="action" href="@item.ProjectLink" target="_blank" rel="noopener noreferrer" aria-label="لینک پروژه">
                                <i class="bi bi-link-45deg"></i>
                            </a>
                            <button class="action portfolio-delete-button" type="button"
                                    data-portfolio-id="@item.Id" data-portfolio-name="@item.ProjectName"
                                    title="حذف نمونه‌کار" aria-label="حذف نمونه‌کار @item.ProjectName">
                                <i class="bi bi-trash3"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/Admin/portfolio.js" asp-append-version="true"></script>
}
