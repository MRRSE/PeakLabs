@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using PeakLabs.Models.Identity
@inject UserManager<PeakLabsUser> UserManager
@inject PeakLabs.Data.ApplicationDbContext DbContext
@{
    var currentDashboardUser = await UserManager.GetUserAsync(User);
    var unseenArticlesCount = currentDashboardUser is null ? 0 : await DbContext.Articles.CountAsync(article => article.PublishedAt > currentDashboardUser.ArticlesLastViewedAt);
    var currentDashboardUserName = currentDashboardUser is null
        ? User.Identity?.Name ?? "کاربر داشبورد"
        : $"{currentDashboardUser.FirstName} {currentDashboardUser.LastName}".Trim();
    if (string.IsNullOrWhiteSpace(currentDashboardUserName))
    {
        currentDashboardUserName = currentDashboardUser?.UserName ?? User.Identity?.Name ?? "کاربر داشبورد";
    }
    var currentDashboardInitials = currentDashboardUser is null
        ? ""
        : string.Concat(currentDashboardUser.FirstName.FirstOrDefault(), currentDashboardUser.LastName.FirstOrDefault()).Trim('\0');
    var currentDashboardRole = User.IsInRole(DashboardRoles.SuperAdmin)
        ? DashboardRoles.SuperAdmin
        : User.IsInRole(DashboardRoles.ContentManager)
            ? DashboardRoles.ContentManager
            : User.IsInRole(DashboardRoles.Editor)
                ? DashboardRoles.Editor
                : null;
}
<!DOCTYPE html>
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    bool IsCurrentPage(string controller, string action = "Index") =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
}
<html lang="fa" dir="rtl" data-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PeakLabs</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/css/Admin/profile.css">
    <link rel="stylesheet" href="~/css/base/variables.css" />
    <link rel="stylesheet" href="~/css/base/reset.css" />
    <link rel="stylesheet" href="~/css/base/typography.css" />
    <link rel="stylesheet" href="~/css/base/utilities.css" />

    <link rel="stylesheet" href="~/css/components/button.css">
    <link rel="stylesheet" href="~/css/components/card.css">
    <link rel="stylesheet" href="~/css/components/form.css">
    <link rel="stylesheet" href="~/css/components/modal.css">
    <link rel="stylesheet" href="~/css/components/navbar.css">
    <link rel="stylesheet" href="~/css/components/pages.css">
    <link rel="stylesheet" href="~/css/Admin/card.css" asp-append-version="true">
    @if (string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Developers", StringComparison.OrdinalIgnoreCase))
    {
        <link rel="stylesheet" href="~/css/Admin/developers.css" asp-append-version="true" />
    }

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/css/admin/admin.css">

</head>

<body>
    <div class="app">
        <aside class="sidebar" id="sidebar">
            <div class="brandDash">
                <svg class="mark" viewBox="0 0 40 40" fill="none" style="margin-top: -7px;">
                    <path d="M4 30 L15 12 L21 21 L26 13 L36 30Z" fill="#10B981" />
                    <path d="M15 12 L21 21 L18 26 L11 26Z" fill="#059669" />
                </svg>
                <span class="brand-name">Peak<span>Labs</span></span>
            </div>
            <div class="side-label">محیط کاری</div>
            <nav class="nav">
                <a class="@(IsCurrentPage("Dashboard") ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i>
                    <span>نمای کلی</span>
                </a>
                <a class="@(IsCurrentPage("Articles") ? "active" : "")" asp-area="Admin" asp-controller="Articles" asp-action="Index">
                    <i class="bi bi-journal-text"></i>
                    <span>مقالات</span>
                    @if (unseenArticlesCount > 0)
                    {
                        <span class="badge badge-new">@unseenArticlesCount</span>
                    }
                </a>
                @if (User.IsInRole(DashboardRoles.SuperAdmin) || User.IsInRole(DashboardRoles.ContentManager))
                {
                    <a class="@(IsCurrentPage("Portfolio") ? "active" : "")" asp-area="Admin" asp-controller="Portfolio" asp-action="Index">
                        <i class="bi bi-kanban"></i>
                        <span>نمونه‌کارها</span>
                    </a>
                }
            </nav>
            <div class="side-label">تیم و دسترسی</div>
            <nav class="nav">
                @if (User.IsInRole(DashboardRoles.SuperAdmin) || User.IsInRole(DashboardRoles.ContentManager))
                {
                    <a class="@(IsCurrentPage("Developers") ? "active" : "")" asp-area="Admin" asp-controller="Developers" asp-action="Index">
                        <i class="bi bi-code-slash"></i>
                        <span>توسعه‌دهندگان</span>
                    </a>
                    <a class="@(IsCurrentPage("ContactMessages") ? "active" : "")" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index">
                        <i class="bi bi-envelope"></i>
                        <span>پیام‌های تماس</span>
                    </a>
                }
                @if (User.IsInRole(DashboardRoles.SuperAdmin))
                {
                    <a class="@(IsCurrentPage("Auth", "AdminUsers") ? "active" : "")" asp-area="Admin" asp-controller="Auth" asp-action="AdminUsers">
                        <i class="bi bi-person-lock"></i>
                        <span>حساب های داشبورد</span>
                    </a>
                }
            </nav>
            <div class="side-label">سیستم</div>
            <nav class="nav">
                <a class="@(IsCurrentPage("Auth", "Profile") ? "active" : "")" asp-area="Admin" asp-controller="Auth" asp-action="Profile">
                    <i class="bi bi-person-circle"></i>
                    <span>پروفایل من</span>
                </a>
                @if (User.IsInRole(DashboardRoles.SuperAdmin) || User.IsInRole(DashboardRoles.ContentManager))
                {
                    <a class="@(IsCurrentPage("System") ? "active" : "")" asp-area="Admin" asp-controller="System" asp-action="Index">
                        <i class="bi bi-sliders2"></i>
                        <span>تنظیمات</span>
                    </a>
                }
            </nav>
            <div class="side-bottom">
                <div class="user-mini">
                    @if (!string.IsNullOrWhiteSpace(currentDashboardUser?.ProfileImagePath))
                    {
                        <img class="avatarDash user-mini-avatar" src="@currentDashboardUser.ProfileImagePath" alt="تصویر پروفایل @currentDashboardUserName" />
                    }
                    else
                    {
                        <div class="avatarDash">@(string.IsNullOrWhiteSpace(currentDashboardInitials) ? "؟" : currentDashboardInitials)</div>
                    }
                    <div>
                        <strong>@currentDashboardUserName</strong>
                        <small>@DashboardRoles.GetDisplayName(currentDashboardRole)</small>
                        @if (!string.IsNullOrWhiteSpace(currentDashboardUser?.UserName))
                        {
                            <small class="user-mini-username">@currentDashboardUser.UserName</small>
                        }
                    </div>
                </div>
                <form method="post" action="@Url.Action("Logout", "Auth", new { area = "Admin" })">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-ghost logout-button" type="submit">
                        <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                        خروج از حساب
                    </button>
                </form>
            </div>
        </aside>
        <div class="main">
            <header class="topbar">
                <div class="top-left">
                    <span class="top-title">PeakLabs</span>
                    <span class="crumb"> / <span id="crumb">نمای کلی</span></span>
                </div>
                <div class="top-actions">
                    <button class="hamburger" id="hamburgerBtn" type="button" aria-label="Open menu"
                            aria-expanded="false">
                        <span></span><span></span><span></span>
                    </button>
                    <button class="icon-btn" id="themeToggle" title="Theme">
                        <i id="themeIcon" class="bi bi-sun"></i>
                    </button>
                </div>
            </header>
            <div>
                <main class="content">
                    @RenderBody()
                </main>
            </div>
        </div>
        <div id="modal" class="modal">
            <div class="dialog">
                <div class="dialog-head">
                    <h2 id="modalTitle"></h2>
                    <button class="icon-btn" onclick="closeModal()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
                <div id="modalBody" class="dialog-body"></div>
                <div class="dialog-foot">
                    <button class="btn btn-outline" onclick="closeModal()" data-t="cancel">انصراف</button>
                    <button class="btn btn-primary" onclick="saveModal()" data-t="save">ذخیره</button>
                </div>
            </div>
        </div>
        <partial name="_Toast" />
    </div>
    <link rel="stylesheet" href="~/css/admin/responsive.css">
    <script src="~/js/admin/dashboard.js" asp-append-version="true"></script>
    <script src="~/js/base/theme.js" asp-append-version="true"></script>
    <script src="~/js/base/main.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
