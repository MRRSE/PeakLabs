@{
    Layout = "_AdminLayout";
}


<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="~/css/admin/developers.css">
</head>

<body>
    <section class="page active">
        <div class="page-head">
            <div>
                <span class="eyebrow">
                    <i class="bi bi-code-slash"></i>
                    <span>توسعه‌دهندگان</span>
                </span>
                <h1>دسترسی توسعه‌دهندگان</h1>
                <p class="muted">اعضایی را که می‌توانند محتوا ایجاد یا ویرایش کنند.</p>
            </div>
            <button class="btn btn-primary">
                <i class="bi bi-person-plus"></i><span>اضافه کردن توسعه‌دهنده</span>
            </button>
        </div>
        <div class="panel">
            <div class="panel-head">
                <h2>همه توسعه‌دهندگان</h2>
                <span class="tiny">8 توسعه‌دهنده</span>
            </div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th data-t="member">عضو</th>
                            <th data-t="role">نقش</th>
                            <th data-t="permissions">دسترسی‌ها</th>
                            <th data-t="lastActive">آخرین فعالیت</th>
                            <th data-t="status">دسترسی‌ها</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="developerRows">
                        <tr>
                            <td>
                                <div class="member">
                                    <div class="avatar">MR</div>
                                    <div>
                                        <div class="item-title">Mohammad Rasteh</div>
                                        <div class="role">developer.rasteh@gmail.com</div>
                                    </div>
                                </div>
                            </td>
                            <td>مدیر ارشد</td>
                            <td>
                                <div class="permissions">
                                    <span class="permission">Articles</span>
                                    <span class="permission">Analytics</span>
                                </div>
                            </td>
                            <td>12 min ago</td>
                            <td><span class="status published">فعال</span></td>
                            <td>
                                <div class="actions">
                                    <button class="action"><i class="bi bi-pencil"></i></button>
                                </div>
                            </td>
                        </tr>
                        @* <tr></tr>
                        <tr></tr>
                        <tr></tr> *@
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</body>
<script src="~/js/admin/developers.js"></script>

</html>