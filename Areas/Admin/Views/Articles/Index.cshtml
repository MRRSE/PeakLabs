@model PeakLabs.Areas.Admin.Models.ArticleAdminIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "مدیریت مقالات";
}

<form id="articleAntiforgeryToken" hidden>@Html.AntiForgeryToken()</form>

<section class="page active">
    <div class="page-head">
        <div>
            <span class="eyebrow"><i class="bi bi-journal-richtext"></i><span>مقالات</span></span>
            <h1>کتابخانه مقالات</h1>
            <p class="muted">مقالات و بخش‌های آن‌ها را مدیریت کنید.</p>
        </div>
        <button class="btn btn-primary" type="button" onclick="openModal('article')">
            <i class="bi bi-plus-lg"></i><span>مقاله جدید</span>
        </button>
    </div>

    <div class="toolbar">
        <div class="search">
            <i class="bi bi-search"></i>
            <input id="articleSearch" type="search" placeholder="جستجوی مقاله..." aria-label="جستجوی مقاله">
        </div>
        <select id="articleStatusFilter" class="select" aria-label="فیلتر وضعیت">
            <option value="">همه وضعیت‌ها</option>
            <option value="published">منتشرشده</option>
            <option value="draft">پیش‌نویس</option>
        </select>
        <select id="articleCategoryFilter" class="select" aria-label="فیلتر دسته‌بندی">
            <option value="">همه دسته‌بندی‌ها</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>

    <div class="panel">
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>مقاله</th><th>نویسنده</th><th>بازدید</th><th>وضعیت</th><th>آخرین تغییر</th><th>عملیات</th></tr></thead>
                <tbody id="articlesTableBody">
                    @if (Model.Articles.Count == 0)
                    {
                        <tr><td colspan="6" class="muted">هنوز مقاله‌ای ثبت نشده است.</td></tr>
                    }
                    @foreach (var article in Model.Articles)
                    {
                        <tr class="article-row" data-article-id="@article.Id" data-category-id="@article.CategoryId"
                            data-status="@article.Status" data-search="@article.Title @article.ShortDescription @article.Category.Name @(article.Author?.FirstName) @(article.Author?.LastName)">
                            <td>
                                <div style="display:flex;align-items:center;gap:10px">
                                    <img src="@article.CoverImage" alt="تصویر @article.Title" width="56" height="42" style="object-fit:cover;border-radius:8px" />
                                    <div><div class="item-title">@article.Title</div><div class="item-desc">@article.ShortDescription</div><small class="muted">@article.Category.Name</small></div>
                                </div>
                            </td>
                            <td>@(article.Author is null ? "نامشخص" : $"{article.Author.FirstName} {article.Author.LastName}".Trim())</td>
                            <td>۰</td>
                            <td><span class="status @(article.Status == "published" ? "published" : "draft")">@(article.Status == "published" ? "منتشرشده" : "پیش‌نویس")</span></td>
                            <td>@article.PublishedAt.ToLocalTime().ToString("yyyy/MM/dd")</td>
                            <td>
                                <div class="actions">
                                    <button class="action article-edit-button" type="button" data-article-id="@article.Id" title="ویرایش" aria-label="ویرایش @article.Title"><i class="bi bi-pencil"></i></button>
                                    <button class="action article-delete-button" type="button" data-article-id="@article.Id" title="حذف" aria-label="حذف @article.Title"><i class="bi bi-trash3"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                    <tr id="articlesNoResults" hidden><td colspan="6" class="muted">مقاله‌ای با این جستجو پیدا نشد.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<script>
    window.articleCategories = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Categories.Select(category => new { category.Id, category.Name }),
        new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
    window.articles = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.Articles.Select(article => new { article.Id, article.Title, article.ShortDescription, article.CoverImage, article.CategoryId, article.Status,
            AuthorName = article.Author is null ? "نامشخص" : $"{article.Author.FirstName} {article.Author.LastName}".Trim(),
            Sections = article.Sections.OrderBy(section => section.Order).Select(section => new { section.HeadingType, section.Title, section.Content }) }),
        new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web)));
</script>

@section Scripts {
    <script src="~/js/Admin/articles.js" asp-append-version="true"></script>
}
