@{
    Layout = "_AdminLayout";
}

<html lang="fa">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="~/css/admin/developers.css">
    <title>Document</title>
</head>

<body>
    <section class="page active">
        <div class="page-head">
            <div>
                <span class="eyebrow">
                    <i class="bi bi-person-lock"></i>
                    <span>حساب های داشبورد</span>
                </span>

                <h1>مدیریت حساب‌های داشبورد</h1>
                <p class="muted">
                    حساب افرادی را که اجازه ورود به پنل مدیریت دارند ایجاد و
                    مدیریت کنید.
                </p>
            </div>
            <button class="btn btn-primary" onclick="openModal('account')">
                <i class="bi bi-person-plus"></i>ایجاد حساب کاربری
            </button>
        </div>
        <div class="account-summary">
            <div class="stat">
                <span class="tiny">تعداد حساب‌ها</span><strong id="accountCount">0</strong>
            </div>
            <div class="stat">
                <span class="tiny">حساب‌های فعال</span><strong id="activeAccountCount">0</strong>
            </div>
            <div class="stat">
                <span class="tiny">حساب‌های غیرفعال</span><strong id="inactiveAccountCount">0</strong>
            </div>
        </div>
        <div class="panel">
            <div class="panel-head">
                <div>
                    <h2>حساب‌های دارای دسترسی</h2>
                    <span class="tiny">این افراد می‌توانند وارد داشبورد شوند.</span>
                </div>
            </div>
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>کاربر</th>
                            <th>نقش</th>
                            <th>دسترسی‌ها</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <div class="member">
                                    <div class="avatar">م‌ر</div>
                                    <div>
                                        <div class="item-title">محمد رسته</div>
                                        <div class="role">developer.rasteh@gmail.com</div>
                                    </div>
                                </div>
                            </td>
                            <td>مدیر ارشد</td>
                            <td>
                                <div class="permissions">
                                    <span class="permission">مدیریت مقالات</span>
                                    <span class="permission">آمار و تحلیل</span>
                                </div>
                            </td>
                            <td><span class="status published">فعال</span></td>
                            <td>
                                <div class="actions">
                                    <button class="action" title="ویرایش حساب" onclick="openModal('account')">
                                        <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="action" title="غیرفعال کردن" onclick="toggleAccount(1)">
                                            <i class="bi bi-power"></i>
                                        </button>
                                </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>
    </body>

</html>