@model PeakLabs.Areas.Admin.Models.ContactMessagesIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "پیام‌های تماس";
}

<section class="page active">
    <div class="page-head">
        <div>
            <span class="eyebrow"><i class="bi bi-envelope"></i><span>تماس با ما</span></span>
            <h1>پیام‌های دریافت‌شده</h1>
            <p class="muted">پیام‌هایی که از فرم تماس سایت ارسال شده‌اند.</p>
        </div>
    </div>
    <div class="panel">
        <div class="table-wrap">
            <table class="table">
                <thead><tr><th>فرستنده</th><th>موضوع</th><th>پیام</th><th>زمان دریافت</th></tr></thead>
                <tbody>
                @if (Model.Messages.Count == 0)
                {
                    <tr><td colspan="4" class="muted">هنوز پیامی دریافت نشده است.</td></tr>
                }
                @foreach (var message in Model.Messages)
                {
                    <tr>
                        <td><div class="item-title">@message.Name</div><a href="mailto:@message.Email">@message.Email</a></td>
                        <td>@message.Subject</td>
                        <td style="white-space:pre-wrap;min-width:280px">@message.Message</td>
                        <td>@message.SentAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="pagination" aria-label="صفحه‌بندی پیام‌ها">
                @if (Model.CurrentPage > 1)
                {
                    <a class="btn btn-secondary" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)">قبلی</a>
                }
                <span class="muted">صفحه @Model.CurrentPage از @Model.TotalPages</span>
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a class="btn btn-secondary" asp-area="Admin" asp-controller="ContactMessages" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)">بعدی</a>
                }
            </nav>
        }
    </div>
</section>
