@model PeakLabs.Models.ArticleIndexViewModel
@using System.Linq

<section class="container section article-list-section">
    <div class="blog-toolbar">
        <label class="search-box" for="articlePublicSearch">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input id="articlePublicSearch" type="search" placeholder="جستجوی مقالات..." autocomplete="off">
        </label>
        <div class="filter-pills" role="group" aria-label="فیلتر دسته‌بندی مقالات">
            <button class="pill active" type="button" data-category-id="">همه</button>
            @foreach (var category in Model.Categories)
            {
                <button class="pill" type="button" data-category-id="@category.Id">@category.Name</button>
            }
        </div>
    </div>

    <p id="articleResultsCount" class="article-results-count" aria-live="polite"></p>
    <div class="article-grid" id="publicArticleGrid">
        @foreach (var article in Model.Articles)
        {
            <partial name="_ArticleCard" model="article" />
        }
    </div>
    <p id="articleListEmpty" class="muted" hidden>
        @(Model.Articles.Count == 0 ? "هنوز مقاله‌ای منتشر نشده است." : "مقاله‌ای با این جستجو پیدا نشد.")
    </p>
</section>
