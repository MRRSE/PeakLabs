@model IReadOnlyList<PortfolioItem>

<section class="section" style="padding-top:0;">
    <div class="container">
        <div class="article-grid">
            @foreach (var item in Model)
            {
                <article class="card">
                    <div class="portfolio-cover">
                        <img src="@item.ProjectImagePath" alt="تصویر پروژه @item.ProjectName" loading="lazy"
                             style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" />
                        <span class="card-year">@item.AddedAt.Year</span>
                    </div>
                    <div class="card-body">
                        <h3>@item.ProjectName</h3>
                        <p class="card-desc">@item.ProjectDescription</p>
                        <a href="@item.ProjectLink" class="card-link" target="_blank" rel="noopener noreferrer">
                            مشاهده پروژه <i class="bi bi-arrow-left"></i>
                        </a>
                    </div>
                </article>
            }
        </div>

        @if (Model.Count == 0)
        {
            <p class="text-center">هنوز نمونه‌کاری ثبت نشده است.</p>
        }
    </div>
</section>
