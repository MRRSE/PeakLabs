@model PeakLabs.Models.HomeIndexViewModel
@{
  ViewData["Title"] = "خانه";
}


@section Styles {
  <link rel="stylesheet" href="~/css/pages/home.css" asp-append-version="true" />
}

<form id="homeViewToken" hidden>@Html.AntiForgeryToken()</form>
  @* Hero section part *@
  <partial name="_HeroSec" />
  @* Categories section part *@
  <partial name="_CategoriesSec" model="Model" />
  <partial name="_ArticleSec" model="Model.Articles" />
  <partial name="_PortfolioSec" />

@section Scripts {
  <script src="~/js/pages/home.js" asp-append-version="true"></script>
}

