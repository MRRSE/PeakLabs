<!DOCTYPE html>
<html lang="fa" dir="rtl" data-theme="dark">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PeakLabs</title>
    <script type="importmap"></script>
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@

    <link rel="stylesheet" href="~/css/base/variables.css" />
    <link rel="stylesheet" href="~/css/base/reset.css" />
    <link rel="stylesheet" href="~/css/base/typography.css" />
    <link rel="stylesheet" href="~/css/base/utilities.css" />

    @* <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> *@

    <link rel="stylesheet" href="~/css/components/button.css">
    <link rel="stylesheet" href="~/css/components/card.css">
    <link rel="stylesheet" href="~/css/components/form.css">
    <link rel="stylesheet" href="~/css/components/modal.css">
    <link rel="stylesheet" href="~/css/components/navbar.css">
    <link rel="stylesheet" href="~/css/components/pages.css">

    <link rel="stylesheet" href="~/css/pages/about.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Vazirmatn:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">

    

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet" href="~/PeakLabs.styles.css" asp-append-version="true" />
</head>

<body>
    <header class="navbar">
        <div class="container nav-inner">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <svg class="brand-mark" viewBox="0 0 40 40" fill="none">
                    <path d="M4 30 L15 12 L21 21 L26 13 L36 30Z" fill="#10B981" />
                    <path d="M15 12 L21 21 L18 26 L11 26Z" fill="#059669" />
                </svg>
                <span class="brand-name">Peak
                    <span>Labs</span>
                </span>
            </a>
            <nav class="nav-links">
                <a asp-action="index" asp-controller="home">خانه</a>
                <a asp-action="index" asp-controller="article">مقالات</a>
                <a asp-action="index" asp-controller="portfolio">نمونه کارها</a>
                <a asp-action="index" asp-controller="aboutus">درباره ما</a>
                <a asp-action="index" asp-controller="contactus">تماس با ما</a>
            </nav>
            <div class="nav-actions">
                <button id="themeToggle" class="icon-btn">
                    <i id="themeIcon" class="bi bi-sun"></i>
                </button>
                <button class="hamburger" id="hamburgerBtn" type="button" aria-label="Open menu" aria-expanded="false">
                    <span></span><span></span><span></span>
                </button>
            </div>
            <nav class="mobile-panel" id="mobilePanel" aria-label="Mobile">
                <a asp-action="index" asp-controller="home">خانه</a>
                <a asp-action="index" asp-controller="article">مقالات</a>
                <a asp-action="index" asp-controller="portfolio">نمونه کارها</a>
                <a asp-action="index" asp-controller="aboutus">درباره ما</a>
                <a asp-action="index" asp-controller="contactus">تماس با ما</a>
            </nav>
        </div>
    </header>
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <div class="brand">
                        <svg class="brand-mark" viewBox="0 0 40 40" fill="none">
                            <path d="M4 30 L15 12 L21 21 L26 13 L36 30Z" fill="#10B981" />
                            <path d="M15 12 L21 21 L18 26 L11 26Z" fill="#059669" />
                        </svg>
                        <span class="brand-name">Pick <Span>Labs</Span></span>
                    </div>
                    <p>استودیوی مهندسی نرم‌افزار که درباره معماری، ابر و هنر ساخت سیستم‌های پایدار می‌نویسد.</p>
                    <div class="footer-social">
                        <a class="icon-btn" href=""><i class="bi bi-github"></i></a>
                        <a class="icon-btn" href=""><i class="bi bi-linkedin"></i></a>
                    </div>
                </div>
                <div class="footer-col">
                    <h4>شرکت</h4>
                    <a asp-controller="AboutUs" asp-action="Index">درباره ما</a>
                    <a asp-controller="Article" asp-action="Index">مقالات</a>
                    <a asp-controller="ContactUs" asp-action="Index">تماس با ما</a>
                </div>
                <div class="footer-col">
                    <h4>شبکه های اجتمایی</h4>
                    <a href="">GitHub</a>
                    <a href="">LinkedIn</a>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© ۲۰۲۶ پیک‌لبز. تمامی حقوق محفوظ است.</span>
                <span>ساخته‌شده با معماری تمیز، درون‌سازمانی.</span>
            </div>
        </div>
    </footer>
    <link rel="stylesheet" href="~/css/components/responsive.css">
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/components/navbar.js"></script>
    <script src="~/js/base/theme.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
