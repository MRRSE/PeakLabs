@model PeakLabs.Areas.Admin.Models.LoginInputModel

<html lang="fa" dir="rtl" data-theme="dark">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>

    <link rel="stylesheet" href="~/css/base/variables.css" />
    <link rel="stylesheet" href="~/css/base/reset.css" />
    @* <link rel="stylesheet" href="~/css/base/typography.css" /> *@
    <link rel="stylesheet" href="~/css/base/utilities.css" />

    <link rel="stylesheet" href="~/css/components/button.css">

    <link rel="stylesheet" href="~/css/admin/login.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&family=Vazirmatn:wght@400;500;600;700;800&display=swap"
    rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body>
    <div class="util-controls">
        <button class="icon-btn" id="themeToggle" type="button" aria-label="Toggle dark mode">
            <i class="bi bi-sun" id="themeIcon" style="margin-top: -2px;"></i>
        </button>
    </div>

    <div class="login-shell">

        <aside class="brand-panel" aria-hidden="true">
            <div class="brand-top"">
                <svg width=" 30" height="30" viewBox="0 0 40 40" fill="none" style="margin-top: -5px;">
                    <path d="M4 30 L15 12 L21 21 L26 13 L36 30Z" fill="#10B981" />
                    <path d="M15 12 L21 21 L18 26 L11 26Z" fill="#059669" />
                </svg>
                <span>Labs</span>Peak
            </div>

            <div class="brand-mid">
                <span class="tag">داشبورد</span>
                <h1>همه چیز درمورد سیستم شما، در یک نما تمیز</h1>
                <p>وارد شوید تا پیش‌رفت را رصد کنید، مقالات منتشرشده را مدیریت کنید و بر فضای کاری مهندسی خود نظارت
                    داشته باشید.</p>
                    <div class="brand-features">
                        <div><i class="bi bi-shield-check"></i> <span>ورود امن و ثبت‌شده</span></div>
                        <div><i class="bi bi-graph-up"></i> <span>وضعیت بلادرنگ استقرار</span></div>
                        <div><i class="bi bi-people"></i> <span>ساخته‌شده برای تیم‌های مهندسی</span></div>
                    </div>
                </div>

                <div class="brand-bottom">© ۲۰۲۶ پیک‌لبز. تمامی حقوق محفوظ است.</div>
            </aside>

            <main class="form-panel">
                <div class="login-card">
                    <div class="mobile-brand">
                        <svg width="26" height="26" viewBox="0 0 40 40" fill="none">
                            <path d="M4 30 L15 12 L21 21 L26 13 L36 30Z" fill="#10B981" />
                            <path d="M15 12 L21 21 L18 26 L11 26Z" fill="#059669" />
                        </svg>
                        Peak<span>Labs</span>
                    </div>

                    <div class="login-head">
                        <h2>ورود به پنل مدیریت</h2>
                    </div>

                    <div class="oauth-row">
                        <button class="oauth-btn" type="button" id="githubBtn">
                            <i class="bi bi-github"></i> GitHub
                        </button>
                        <button class="oauth-btn" type="button" id="googleBtn">
                            <i class="bi bi-google"></i> Google
                        </button>
                    </div>

                    <div class="divider">
                        <span>یا با نام کاربری ادامه دهید</span>
                    </div>

                    <form id="loginForm" method="post" action="@Url.Action("Login", "Auth", new { area = "Admin" })" autocomplete="off">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="form-alert error show" id="formAlert" role="alert">
                                <i class="bi bi-exclamation-circle"></i>
                                <span id="formAlertText">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(value => value.Errors))
                                    {
                                        <span>@error.ErrorMessage</span>
                                    }
                                </span>
                            </div>
                        }
                        <div class="form-group">
                            <label for="loginUserName">نام کاربری</label>
                            <div class="input-wrap">
                                <i class="bi bi-person leading"></i>
                                <input type="text" id="loginUserName" name="UserName" value="@Model.UserName" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="نام کاربری"
                                       maxlength="50" required />
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="loginPassword">رمزعبور</label>
                            <div class="input-wrap">
                                <i class="bi bi-lock leading"></i>
                                <input type="password" id="loginPassword" name="Password" autocomplete="new-password" data-lpignore="true" data-1p-ignore
                                       placeholder="••••••••" required minlength="8" maxlength="100">
                                <button type="button" class="toggle-pw" id="togglePw" aria-label="Show password"><i
                                    class="bi bi-eye" id="togglePwIcon"></i></button>
                                </div>
                            </div>

                            <div class="form-row-between">
                                <label class="remember">
                                    <input type="checkbox" id="rememberMe" name="RememberMe" value="true">
                                    <span>مرا به خاطر بسپار</span>
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary" id="submitBtn" style="width: 100%;">
                                <span class="spinner"></span>
                                <span class="btn-label">ورود</span>
                            </button>
                    </form>
                </div>
            </main>
        </div>
        <div class="provider-modal" id="providerModal" aria-hidden="true">
            <div class="provider-modal-backdrop" data-close-provider-modal></div>
            <section class="provider-dialog" role="dialog" aria-modal="true" aria-labelledby="providerModalTitle">
                <div class="provider-dialog-head">
                    <h2 id="providerModalTitle">ورود با این روش</h2>
                    <button class="icon-btn" type="button" id="closeProviderModal" aria-label="بستن">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="provider-dialog-body">
                    <span class="provider-dialog-icon"><i class="bi bi-info-circle" aria-hidden="true"></i></span>
                    <p>این روش ورود فعلاً در دسترس نیست.</p>
                </div>
                <div class="provider-dialog-foot">
                    <button class="btn btn-primary" type="button" id="dismissProviderModal">متوجه شدم</button>
                </div>
            </section>
        </div>
        <script src="~/js/base/theme.js"></script>
        <script src="~/js/admin/login.js"></script>
    </body>
</html>
